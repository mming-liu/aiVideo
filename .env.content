# ============================================================
# AI Video 配置 - 内容参数
# ============================================================
# 本文件控制视频生成的行为参数（风格、分镜、尺寸等）
# API Keys 单独放在 .env.keys 文件中
# ============================================================

# ============================================================
# 1. 核心配置（必需）
# ============================================================
# 小说信息
NOVEL_NAME=锦衣夜行
NOVEL_CHAPTER=1
BOOK_INDEX=1
BOOK_NAME=杀青州

# 输出根目录
OUTPUT_BASE=./output/video

# ============================================================
# 2. 供应商选择
# ============================================================
TEXT_PROVIDER=deepseek       # 文本生成: deepseek | dashscope | agnes
VIDEO_PROVIDER=bailian        # 视频生成: agnes | dashscope | bailian
IMAGE_PROVIDER=bailian         # 图片生成: agnes | bailian
IMAGE_MULTI_REF=1             # 图片参考图数量: 1=单张(默认) | 2+=多张(同框多角色各自传肖像)
TTS_PROVIDER=dashscope_sdk  # 语音合成: dashscope__sdk | dashscope_http | openai

# 导演电影感风格（12位导演，详见 shared/style_cinematic.py）
# 可选: wong_kar_wai | kubrick | villeneuve | fincher | malick | anderson |
#       sp spielberg | hitchcock | kurosawa | fellini | bergman | nolan
# 也支持中文别名: 王家卫 | 库布里克 | 维伦纽瓦 | 诺兰 等
# CINEMATIC_STYLE=

# ============================================================
# 3. 分镜生成（step01）
# ============================================================
# 分镜数量范围（软护栏：v4.1 起镜头数由 LLM 决定，此范围仅用于 validation 提示，不进入 prompt）
# 打斗短镜快切会让镜头数偏多，故 MAX 放宽到 25
SHOT_COUNT_MIN=6
SHOT_COUNT_MAX=25

# 角色提取（默认开启）
CHARACTER_EXTRACTION_ENABLED=1

# 钩子分镜（默认开启）
HOOK_ENABLED=1

# 间隔分析（默认关闭）
GAP_ANALYSIS_ENABLED=0

# ============================================================
# 4. 视频生成（step02）
# ============================================================
# 画面尺寸（9:16 竖屏）
VIDEO_SIZE=720*1280

# 单镜头时长（秒）
VIDEO_DURATION=6

# 视频并发数
VIDEO_CONCURRENCY=6

# 单镜头最大重试次数
VIDEO_MAX_RETRIES=3

# 视频模型自带语音（对话/背景音交给视频模型生成，2026-08 起默认开启）。
# 0 = 旧行为（模型静音，语音由 step03 TTS 提供）
VIDEO_MODEL_VOICE=1

# 参考图模式（全程统一，不分 Mode A/B；step02a 帧生成仅供调试，step02b 按本模式直接生成）:
#               r2v   参考图生视频（推荐）：参考图自动取角色肖像注册表
#                     （character_portraits_registry.json 出镜角色，视角匹配，最多5个），
#                     保持角色/道具一致性，无需先生成帧图片
#               text  文生视频（跳过所有帧/参考图，纯 prompt 生成）
#               image 图生视频（需先运行 step02a 生成帧图片）
VIDEO_REFERENCE_MODE=r2v

# 自动确认（跳过交互提示）
VIDEO_AUTO_CONFIRM=1

# ============================================================
# 7. 图片质检（ds-vision-skill 视觉 QC，step02a 帧生成后自动检查首帧+尾帧）
# ============================================================
# 总开关（默认开启）。关闭后 step02a 不做视觉质检
# IMAGE_QC_ENABLED=1
# 单次质检超时（秒）。Agnes 视觉端点响应慢，默认 300
# IMAGE_QC_TIMEOUT_SEC=300
# 是否把 critical 级问题写入 sidecar（默认 0=封顶为 warning）。
# 注意：step02b submit_poll 读到 critical 会自动删帧重生成，封顶为 warning 可避免触发，
# 质检结果仍会完整记录在日志中。设为 1 则允许 sidecar 携带 critical 并触发 step02b 重生成。
# IMAGE_QC_WRITE_CRITICAL=0

# 视频风格（13种可选）
# gufeng       - 古风真人（默认）
# ghibli       - 吉卜力动画
# healing      - 治愈系插画风
# fairy_tale   - 童话绘本风
# oil_painting - 油画电影风
# pixar        - 皮克斯3D卡通
# clay         - 粘土定格风
# absurd       - 荒诞卡通风
# sketch       - 孩童草稿风
# disney       - 迪士尼童话风
# flat         - 扁平矢量风
# ink_painting - 国风水墨动画
# anime        - 二次元漫剧
VIDEO_STYLE=ink_painting

# ============================================================
# 5. TTS 语音（step03）
# ============================================================
# 语速：0.5~2.0，0.8x + 250字 < 29s 音频
DASHSCOPE_TTS_RATE=0.8

# 音量：0~100
DASHSCOPE_TTS_VOLUME=50

# ============================================================
# 6. 片段合并（step04）
# ============================================================
# FFmpeg 路径（留空则从系统 PATH 查找）
FFMPEG_BIN_DIR=C:/Users/ee54/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-8.1.2-full_build/bin

# 旁白音量增益（dB）
FFMPEG_AUDIO_VOLUME=5dB

# 开场标题（默认关闭）
OPENING_ENABLED=0

# 视频来源
CLIP_SOURCE=vimax

# 合并模式：2026-08 起仅 native（纯视频拼接，保留视频原声，语音/背景音由视频模型生成）
# 已删除 stretch/concat 与 final-A/final-B 双版本输出
MERGE_MODE=native

# ============================================================
# 以下为高级配置，通常无需修改
# ============================================================

# --- DeepSeek 文本模型 ---
# DEEPSEEK_MODEL=deepseek-v4-flash          # = 默认值
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  # = 默认值

# --- Agnes 文本模型 ---
# AGNES_TEXT_MODEL=agnes-2.0-flash          # = 默认值
# AGNES_TEXT_ENABLE_THINKING=1              # = 默认值

# --- Agnes 视频模型 ---
# AGNES_VIDEO_MODEL=agnes-video-v2.0        # = 默认值
# AGNES_VIDEO_WIDTH=720                     # = 默认值
# AGNES_VIDEO_HEIGHT=1280                   # = 默认值
# AGNES_VIDEO_FRAME_RATE=24                 # = 默认值

# --- Agnes 图片模型 ---
# AGNES_IMAGE_MODEL=agnes-image-2.1-flash   # = 默认值
# IMAGE_GEN_INTERVAL=21                     # = 默认值

# --- DashScope TTS ---
# DASHSCOPE_TTS_MODEL=sambert-zhide-v1      # = 默认值

# --- 高级参数（谨慎修改）---
# AGNES_VIDEO_SUBMIT_RETRIES=10             # 视频提交重试次数 = 默认值
# AGNES_VIDEO_POLL_INTERVAL=8               # 视频轮询间隔(秒) = 默认值
# DASHSCOPE_TTS_FORMAT=mp3                  # = 默认值
# DASHSCOPE_TTS_SAMPLE_RATE=16000           # = 默认值

# --- Bailian (百炼) 模型配置 ---
# 文生图 T2I 模型
BAILIAN_T2I_MODEL=qwen-image-2.0-pro-2026-06-22
#BAILIAN_T2I_FALLBACK_MODELS=qwen-image-2.0-pro-2026-06-22

# 文生视频 T2V 模型
BAILIAN_T2V_MODEL=wan2.7-t2v-2026-06-12

# 图生视频 I2V 模型
#BAILIAN_I2V_MODEL=happyhorse-1.0-i2v
#BAILIAN_I2V_FALLBACK_MODELS=wan2.7-i2v-2026-04-25,happyhorse-1.1-i2v

#参考生视频
# 2026-08：对话/背景音交给视频模型，须用 wan2.7-r2v（支持有声视频 reference_voice）；
# happyhorse-1.1-r2v 无音频参数（见 docs/bailian/api-docs/HapplyHouse-RToVideo.md），留作回退。
BAILIAN_R2V_MODEL = wan2.7-r2v-2026-06-12
BAILIAN_R2V_FALLBACK_MODELS = happyhorse-1.1-r2v

# Bailian 视频参数
BAILIAN_VIDEO_RESOLUTION=720P             # 720P 或 1080P
BAILIAN_VIDEO_RATIO=9:16                  # 16:9, 9:16, 1:1
BAILIAN_VIDEO_DURATION=5                  # 2-15 秒
BAILIAN_VIDEO_POLL_INTERVAL=15            # 轮询间隔(秒)
BAILIAN_VIDEO_MAX_POLL_ATTEMPTS=120       # 最大轮询次数