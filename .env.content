# ============================================================
# AI Video 配置 - 内容参数
# ============================================================
# 本文件控制视频生成的行为参数（风格、分镜、尺寸等）
# API Keys 单独放在 .env.keys 文件中
# 加载方式：各模块经 load_dotenv 解析 key-value，与注释/分组/顺序无关，
# 请勿删除或重命名任何 key（default 注释 = 该键省略时的默认值）。
# ============================================================

# ============================================================
# 1. 小说输入（章节目录定位）
# ============================================================
NOVEL_NAME=锦衣夜行
NOVEL_CHAPTER=1
BOOK_INDEX=1
BOOK_NAME=杀青州

# 输出根目录（小说 → 部 → 章 三级结构）
OUTPUT_BASE=./output/video

# ============================================================
# 2. 供应商选择（Provider 抽象，按阶段切换）
# ============================================================
# ⚠️ 单一事实源：shell 变量会覆盖本文件（dotenv 默认行为）；启动时
#    shared/env_guard.py 会检测并 WARN。切 agent_plan/doubao 前请确认：
#      - AGENT_PLAN_TEXT_MAX_TOKENS（本文件唯一来源，provider 已无兜底常量）
#      - 接受 doubao-seed-2-1-turbo 单次 3-5 分钟 + 弱于 deepseek 的对白/机位/覆盖
TEXT_PROVIDER=agent_plan     # 文本生成: deepseek | dashscope | agnes | agent_plan
IMAGE_PROVIDER=agent_plan     # 图片生成: agnes | bailian | volcengine | minimax | agent_plan
# v6.59.1 切换：agent_plan/doubao-seedream-5-0-lite（参考图上限 3 张，Small 套餐）。
# 代价：4.5 14 张 → 5.0-lite 3 张；多角色同框（≥4 角色）会被裁。
# ⚠️ 首尾帧模式(image)下切 minimax 会因带尾帧自动升 H3（贵），不回落 v1 便宜档；
# 日常跑量留火山免费 Seedance 1.0，关键镜头/验收才切 MiniMax H3 或火山付费档（详见 CLAUDE.md）
VIDEO_PROVIDER=volcengine    # 视频生成: agnes | dashscope | bailian | volcengine | minimax | agent_plan
# 2026-09-05: agent_plan 救场失败（1.5 pro 即将下线拒接入，2.0 系列 Medium 不支持），回 volcengine 跑免费 Seedance 1.0 pro 额度
# 2026-09-12: volcengine 免费 1.0 额度耗尽（SetLimitExceeded）→ 切 agent_plan 复测：1.5 pro 四种 ID 写法
#   （1-5-pro / 1-5-pro-251215 / 1.5-pro / 1.5-pro-即将下线）+ 2.0 全部 404 UnsupportedModel，
#   官方 skill 脚本同样 404（排除我方代码）——套餐视频通道确认不可用，回 volcengine，等控制台调高限额后续跑剩余 6 镜
TTS_PROVIDER=dashscope_sdk    # 语音合成: dashscope_sdk | dashscope_http | openai

# 图片参考图数量（step02a 图生图）— 用户偏好（省钱软上限）
# 1=单张(默认) | 2+=多张(同框多角色各自传肖像)
# 实际硬上限 = min(IMAGE_MULTI_REF, 模型能力)：
#   模型能力按 IMAGE_PROVIDER 主模型从 shared/ref_compose.py 注册表解析
#   （qwen-image=3 / seedream 4.5=14 / image-01(MiniMax)=1 / ...），见下方 IMAGE_MAX_REFS 注释
IMAGE_MULTI_REF=2

# ============================================================
# 3. 分镜生成（step01）
# ============================================================
# 分镜数量范围（v6.38 红果短剧标准，08-22 起）
# 红果 60-90s 单集标准 = 8-10 镜 + 2-3 场景 + 2-4 人物 + 强制三件套
# 08-23 v6.41 P19 闭环：原 3-8 镜 LLM 按 6s/镜平均 → 48s 不到 60s；
# v6.43（08-23 用户规则）镜头数不限：MIN/MAX 任一 ≤0 即视为不限，
# prompts.py _build_total_duration_constraint 走「按动作密度自然拆分」分支，
# main.py _regen_over_limit 直接 return script 不触发收敛重生成，
# validation.py 跳过 sanity 范围检查。红果硬约束只剩：
#  - 正片分镜 SUM(duration_sec) 60-90s（不含钩子）
#  - 单镜 ≤ 8s（>8s 必拆镜，不靠 timecode.py 静默 clamp）
#  - ≤ 3 场景 / ≤ 4 人物（业务硬约束）
SHOT_COUNT_MIN=0
SHOT_COUNT_MAX=0

CHARACTER_EXTRACTION_ENABLED=1

HOOK_ENABLED=1

# 间隔分析：gap 不过时重生成，并附带 checklist 校验反馈 build_regen_feedback
GAP_ANALYSIS_ENABLED=1

# 导演电影感风格（12位导演，详见 shared/style_cinematic.py）
# 可选: wong_kar_wai | kubrick | villeneuve | fincher | malick | anderson |
#       spielberg | hitchcock | kurosawa | fellini | bergman | nolan
# 也支持中文别名: 王家卫 | 库布里克 | 维伦纽瓦 | 诺兰 等
# CINEMATIC_STYLE=

# ============================================================
# 4. 图片生成（step02a 帧 + 场景/道具资产图）
# ============================================================
# 视频风格（13种可选）
# gufeng       - 古风真人（默认）
# ghibli       - 吉卜力动画
# healing      - 治愈系插画风
# fairy_tale   - 童话绘本风
# oil_painting - 油画电影风
# pixar        - 皮克斯3D卡通
# clay         - 粘土定格风
# absurd       - 荒诞卡通风
# sketch       - 孩童草稿风
# disney       - 迪士尼童话风
# flat         - 扁平矢量风
# ink_painting - 国风水墨动画
# anime        - 二次元漫剧
VIDEO_STYLE=ink_painting

VIDEO_SIZE=1440*2560

VIDEO_DURATION=6

# 参考图模式（全程统一，不分 Mode A/B；step02a 帧生成仅供调试，step02b 按本模式直接生成）:
#               r2v   参考图生视频（推荐）：参考图自动取角色肖像注册表
#                     （character_portraits_registry.json 出镜角色，视角匹配，最多5个），
#                     保持角色/道具一致性，无需先生成帧图片
#               text  文生视频（跳过所有帧/参考图，纯 prompt 生成）
#               image 图生视频（需先运行 step02a 生成帧图片）
# 当前：image（适配火山免费 Seedance 1.0——无 reference_image 能力，image 模式只发首尾帧）。
# ⚠️ 待火山免费 Seedance 1.0 额度消耗完后，恢复 r2v（古风权谋角色一致性最关键）；
#    切回 bailian/minimax 生产时也必须改回 r2v，否则角色/道具一致性会弱化。
VIDEO_REFERENCE_MODE=image

# ============================================================
# 5. 视频生成（step02b）
# ============================================================
# 视频提交并发（2026-09 单源化到 shared/config.py，默认 4；如需覆盖再取消注释）
# VIDEO_CONCURRENCY=4

VIDEO_MAX_RETRIES=3

# 视频模型自带语音（对话/背景音交给视频模型生成，2026-08 起默认开启）。
# 0 = 旧行为（模型静音，语音由 step03 TTS 提供）
VIDEO_MODEL_VOICE=1

# ============================================================
# 6. TTS 语音（step03）
# ============================================================
# 语速：0.5~2.0，0.8x + 250字 < 29s 音频
DASHSCOPE_TTS_RATE=0.8

# 音量：0~100
DASHSCOPE_TTS_VOLUME=50

# ============================================================
# 7. 片段合并（step04）
# ============================================================
# FFmpeg 路径（留空则从系统 PATH 查找）
FFMPEG_BIN_DIR=C:/Users/ee54/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-8.1.2-full_build/bin

# 音频音量：优先走逐镜响度归一（MERGE_AUDIO_LOUDNORM=1，EBU R128），
# 此处固定增益仅在归一关闭时生效。调试期建议留空走 loudnorm
FFMPEG_AUDIO_VOLUME=

CLIP_SOURCE=vimax

# ---- 成片画质（2026-08-22 升级 1440x2560 适配 Seedream 4.5 像素下限 3686400）----
# 主视频帧 VIDEO_SIZE=1440*2560（9:16 竖屏，3,686,400 像素 = 4.5 下限）
# 资产图 2560x1440（横屏，同像素满足 4.5 下限）
# 视频模型仍 720P（VOLCENGINE_VIDEO_RESOLUTION / BAILIAN_VIDEO_RESOLUTION 保留 720P 省生成额度）
MERGE_RESOLUTION=1440x2560
# x264 编码：preset ultrafast→medium（画质↑，仅本地 CPU 成本）；CRF 18=高质量
MERGE_PRESET=medium
MERGE_CRF=18
# 音频模式：native=只保留视频原声（默认）；tts_mix=叠加 step03 TTS 对白轨
# （对视频原声不满意时切换：先跑 step03 再跑 step04；原声自动压低至 0.6）
MERGE_AUDIO_MODE=native
# 逐镜响度归一（消除镜头间音量跳变，EBU R128；0=关闭走固定增益）
MERGE_AUDIO_LOUDNORM=1

# ============================================================
# 8. 图片质检（ds-vision-skill 视觉 QC，step02a 帧生成后自动检查首帧+尾帧）
# ============================================================
# 总开关（默认开启）。关闭后 step02a 不做视觉质检
# IMAGE_QC_ENABLED=1
# 单次质检超时（秒）。Agnes 视觉端点响应慢，默认 300
# IMAGE_QC_TIMEOUT_SEC=300
# 是否把 critical 级问题写入 sidecar（默认 0=封顶为 warning）。
# 注意：step02b submit_poll 读到 critical 会自动删帧重生成，封顶为 warning 可避免触发，
# 质检结果仍会完整记录在日志中。设为 1 则允许 sidecar 携带 critical 并触发 step02b 重生成。
# v6.50（08-28）：调试期聚焦图片质量——开启拦截，让「画不对」的帧当场重生成，
# 不再带病流入 step02b 烧视频额度。
IMAGE_QC_WRITE_CRITICAL=1
# 关键锚点（服装颜色/人物数量/威胁源状态）与画面描述明显不符时的严重度：
# 0（默认）= warning 只记录；1 = critical 删帧重生成（当场拦住「画不对」的帧）。
# 需配合 IMAGE_QC_WRITE_CRITICAL=1 才写 sidecar 触发 step02b 重生成。
# v6.50（08-28）：与上项同步开启（钩子首帧「匕首提前插胸口」这类时序错误靠它拦）。
QC_SEMANTICS_CRITICAL=1

# --- 视频质检（step02b，VIDEO_QC_ENABLED=1 时生效）---
# 视频 QC 失败自动重提交次数（固定 seed 后可复现；0=关闭，失败即标记重生成）
# VIDEO_QC_RESUBMIT=2

# --- step01 定向修复轮（P18 闭环，默认开启）---
# GAP 通过后高价值告警（开篇冲突/爆点密度/威胁源朝向/关键帧质量/内容密度）
# 触发单镜修复：只重写告警镜头，不重生成全脚本。0=关闭（回到纯 WARN 打印）
# REPAIR_ROUNDS_ENABLED=1

# --- 图片 prompt 矛盾自检器（v6.50，08-28）---
# step02a 提交前检测确定性自相矛盾（武器持有/否认对称、禁黑影+需黑影、
# 描述块重复注入、双句号）。1=发现即抛错拦帧（fail-fast，调试期推荐）；
# 0=降级为告警放行。检测器只报高精度矛盾，无误报拦截风险。
PROMPT_CONTRADICTION_STRICT=1

# --- step01 硬修复路径切换（v6.42+ Constraint 框架）---
# HARD_FIX_USE_OLD 已删除（2026-09-12，旧 _hard_fix_* 路径移除）；设置仅告警一次，仍走 Constraint 框架。
# ⚠️ 该变量若曾在 shell 里 export（调试后忘 unset），后续所有运行（含 pytest）
#    都会静默继承——engine 启动时会在日志声明当前路径，排障后记得 unset。
# HARD_FIX_USE_OLD=0（已失效，保留行避免旧 .env 报未知键）

# ============================================================
# 以下为高级配置，通常无需修改
# ============================================================

# --- 文本模型（_text_gen）---
# DeepSeek（默认）
# DEEPSEEK_MODEL=deepseek-v4-flash          # = 默认值
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  # = 默认值
# 思考模式强度 low/high/max。
# none=关闭思考（旧行为，v4.1 起一直如此：防止思维链吃光 token 导致正文为空）。
# 由 tools/bench_reasoning.py 实测各档位对分镜质量的影响后决定是否切换（--apply 自动写入）。
DEEPSEEK_REASONING_EFFORT=low               # low=开启低强度思考（v6.59 工作树修改，旧默认是 none）
# DeepSeek 单次响应输出 token 上限（可选）。注释掉 = 不约束（API 默认值生效）。
# 有值 = 按值传 max_output_tokens 给 API。注意：该上限**包含思维链 token**——
# 思考强度越高，思维链吃掉的 token 越多，留给实际正文的越少。
# 推荐分镜生成场景：40000-50000；钩子：8000；修复轮：50000。
# v6.50（08-28）：置 50000——留空=不传 API 默认值，全脚本 JSON 响应在
# provider 侧被截断（json_repair 捞回「镜头推近至」等残句直接落盘）。
DEEPSEEK_MAX_TOKENS=50000

# --- 图片模型（_image_gen）---（默认值见 _image_gen/*/config.py）
# 图片单次请求参考图上限 — 仅作「未注册模型」的回退值。
# 实际上限按模型名从 shared/ref_compose.py 注册表解析（市面调研 2026-08）：
#   qwen-image 系列=3｜wan2.7-image=9｜wan2.7-r2v=5｜happyhorse=9
#   Seedream 图片：5.0 pro=10｜5.0 lite/4.5/4.0=14
#   MiniMax image-01=1（subject_reference 官方仅支持单张）｜MiniMax-H3=9
#   Seedance 2.5=30｜2.0=12（注意模型 ID 是破折号 doubao-seedance-2-5-*，模式须匹配得上）
# 超上限时无损压缩（参考图必须全部传过去）：
#   bridge 层按类别拼表（环境/人物/道具各 1 张）；provider 层保留前 N-1 张 + 尾部拼表
IMAGE_MAX_REFS=3

# --- 视频模型（_video_gen）---（默认值见 _video_gen/*/config.py）

# --- TTS（tts）---（默认值见 tts/*/config.py）

# ============================================================
# Bailian（百炼）模型配置 — IMAGE_PROVIDER/VIDEO_PROVIDER=bailian 时生效
# ============================================================
# --- Bailian 图片（图生图/文生图）---
# qwen-image-3.0-pro：复杂指令遵循最强（hook 锚点保真，08-15 验收通过）。RPM≈1/min，
#   BAILIAN_IMAGE_RPM=1 让 provider 每请求预限速 60s；429 时按冷却窗口等待重试；
#   403（额度/权限）时自动回退 wan2.7-image → wan2.7-image-pro。
# wan2.7-image（标准版）：RPM 300/min，参考图最多 9 张，最高 2K（回退首选）。
# wan2.7-image-pro：文生图可到 4K，编辑最高 2K，主体一致性更强（回退末位）。
BAILIAN_T2I_MODEL=qwen-image-3.0-pro
BAILIAN_T2I_FALLBACK_MODELS=wan2.7-image,wan2.7-image-pro
BAILIAN_IMAGE_RPM=1

# --- Bailian 视频（文生视频/图生视频/参考生视频）---
BAILIAN_T2V_MODEL=wan2.7-t2v-2026-06-12

#BAILIAN_I2V_MODEL=happyhorse-1.0-i2v
#BAILIAN_I2V_FALLBACK_MODELS=wan2.7-i2v-2026-04-25,happyhorse-1.1-i2v

# 参考生视频 R2V
# 2026-08：对话/背景音交给视频模型，须用 wan2.7-r2v（支持有声视频 reference_voice）；
# happyhorse-1.1-r2v 无音频参数（见 docs/bailian/api-docs/HapplyHouse-RToVideo.md），不参与回退链。
BAILIAN_R2V_MODEL=wan2.7-r2v-2026-06-12

# --- Bailian 视频参数 ---
BAILIAN_VIDEO_RESOLUTION=720P             # 720P 或 1080P
BAILIAN_VIDEO_RATIO=9:16                  # 16:9, 9:16, 1:1
BAILIAN_VIDEO_DURATION=5                  # 2-15 秒
BAILIAN_VIDEO_POLL_INTERVAL=180           # 轮询间隔(秒)，3min一次（对齐 step02 POLL_BASE_INTERVAL）
BAILIAN_VIDEO_MAX_POLL_ATTEMPTS=120       # 最大轮询次数

# ============================================================
# 火山方舟（Volcengine Ark） 免费预置图片/视频模型
# IMAGE_PROVIDER/VIDEO_PROVIDER=volcengine 时生效
# ============================================================
# 免费预置模型：2026-08 官方开通管理，按用户策略优先消耗低质量/剩余多的免费模型
#   T2I 图片优先级: 4.0(200张) > 4.5(200张) > 5.0-lite(50张)
#   T2V/I2V 视频:   1.0-pro(免费，实测提交成功)
# 注意：控制台/教程短 ID（doubao-seedream-4.0、wan2-1-14b 等）是控制台别名，
#     真实 API 必须用破折号完整 ID（实测：短 ID 全 404，完整 ID 200/提交成功）。
#     shared/model_caps.py + shared/ref_compose.py 已兼容点号/破折号双写法。
# --- 火山图片（Seedream，生产 4.5，2026-08-22 切换）---
# 4.5 像素下限 3686400（≈ 1920x1920）→ 主视频帧 1440x2560 = 3686400 刚好下限 / 资产图 2560x1440 同
# 4.0 留作 fallback（4.5 档位不可用时降级；4.0 像素下限 921600 兼容老小图）
VOLCENGINE_T2I_MODEL=doubao-seedream-4-5-251128
VOLCENGINE_T2I_FALLBACK_MODELS=doubao-seedream-4-0-250828,doubao-seedream-5-0-lite-260128
# VOLCENGINE_IMAGE_SIZE=              # 空=按分镜推导，档位(1K/2K/4K)或像素(WxH)
# VOLCENGINE_BASE_URL=                 # 空=默认 https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_IMAGE_RPM=                # 单 key 限速（默认 10，bailian=1 省钱可改 1）

# --- 火山视频（Seedance 1.0 pro 免费 + 1.5 pro 兜底）---
# 主备模型分开（避免 403 时回退到同一个模型导致死循环）。
# ⚠️ 1.5 pro 不是免费档，回退会消耗付费额度。默认 FALLBACK 留空：
#   - 用户当前只开通了 1.0 pro 免费档（200万 tokens），主模型 403 时直接失败更安全
#   - 充值后启用付费 1.5 pro 作回退时，把下方注释行的 1.5-pro 解开即可
#     （不要回退到自身，403 死循环无法退出）
VOLCENGINE_T2V_MODEL=doubao-seedance-1-0-pro-250528
VOLCENGINE_T2V_FALLBACK_MODELS=
VOLCENGINE_I2V_MODEL=doubao-seedance-1-0-pro-250528
VOLCENGINE_I2V_FALLBACK_MODELS=
# VOLCENGINE_T2V_FALLBACK_MODELS=doubao-seedance-1-5-pro-251215   # 付费档，充值后启用
# VOLCENGINE_I2V_FALLBACK_MODELS=doubao-seedance-1-5-pro-251215   # 付费档，充值后启用

# --- 火山方舟视频参数 ---
VOLCENGINE_VIDEO_RESOLUTION=720p          # 480p/720p/1080p/4k；空=按 req.size 推导
VOLCENGINE_VIDEO_RATIO=9:16               # 16:9/9:16/1:1；空=按 req.size 推导
VOLCENGINE_VIDEO_DURATION=0               # 秒；0=按分镜 duration_sec
VOLCENGINE_VIDEO_POLL_INTERVAL=8          # 轮询间隔(秒)
VOLCENGINE_VIDEO_MAX_POLL_ATTEMPTS=120    # 最大轮询次数

# ── v6.53 QC 三层架构（检测链 agnes→dashscope→ark；router 降 warning 兜底）──
QC_PROVIDER=auto
QC_PERSON_TOLERANCE=0
QC_MAX_ATTEMPTS=3
# QC_DASHSCOPE_VISION_MODEL=qwen-vl-max
# QC_ARK_MODEL=doubao-seed-1-6-250615（当前账号未开通 ARK 视觉 chat，404）

# ============================================================
# 火山方舟 Agent Plan (/api/plan/v3) — 2026-08-31 更新
# ============================================================
# 与标准方舟(/api/v3) 端点不同，**专属 key 不通用**（普通 ARK key 报 401）。
# 官方 API 端点（contents/generations/tasks，2026-08-31 核实）：
#   视频创建  POST {base}/contents/generations/tasks
#   视频查询  GET  {base}/contents/generations/tasks/{id}
#   视频列表  GET  {base}/contents/generations/tasks?page_num=&page_size=...
#   视频取消  DELETE {base}/contents/generations/tasks/{id}
#   图片生成  POST {base}/images/generations
# 切换：IMAGE_PROVIDER=agent_plan / VIDEO_PROVIDER=agent_plan（同时改对）
# ⚠️ 当前支持模型（2026-08-31）：
#    图片：doubao-seedream-5-0-lite（参考图上限 3 张，Small 套餐）
#    视频：doubao-seedance-1-5-pro（即将下线！支持首帧/首尾帧/有声，不支持 reference_image r2v）
#    因 1.5-pro 不支持 r2v，VIDEO_REFERENCE_MODE 仅能走 image（首尾帧）或 text（文生视频）。
#    下线后切回 volcengine 或等待 Agent Plan 上架新视频模型。
# 燃料查询：控制台 → Agent Plan → 燃料管理；或 GET {base}/fuel/query（Small 套餐限定）。
AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# Agent Plan 套餐管理 base_url（key 识别用），但 Seedance 视频任务不在该路径下
# （实测 404 "does not support the agent plan feature"），要走 /api/v3 用 VOLCENGINE key
AGENT_PLAN_T2I_MODEL=doubao-seedream-5-0-lite
# 2026-09-12: 接入 1.5 pro（用户指令）。Agent Plan 文档矩阵用点号写法 doubao-seedance-1.5-pro
# （短横线+日期后缀的 api/v3 写法会 404 UnsupportedModel，实测 15:53）
AGENT_PLAN_T2V_MODEL=doubao-seedance-1.5-pro
# Agent Plan 套餐管理 base_url（key 识别用），但 Seedance 视频任务不在该路径下
# （实测 404 "does not support the agent plan feature"），要走 /api/v3 用 VOLCENGINE key
# 2026-09-05：保留这个配置但回 volcengine 跑免费 Seedance 1.0 pro。等 1.0 额度耗尽再回来试 2.0。
# 用户实测：Medium 套餐仅支持 1.5 pro（即将下线，拒接入），2.0 系列不支持。
AGENT_PLAN_VIDEO_RESOLUTION=720p
AGENT_PLAN_VIDEO_RATIO=9:16
AGENT_PLAN_VIDEO_DURATION=0
AGENT_PLAN_VIDEO_POLL_INTERVAL=20
AGENT_PLAN_VIDEO_MAX_POLL_ATTEMPTS=25
AGENT_PLAN_MAX_CONCURRENCY=2
# ---- 文本通道（2026-09-03 新增，doubao-seed-2-1-turbo 作为分镜分解模型）----
# 切换：TEXT_PROVIDER=agent_plan（与 IMAGE/VIDEO_PROVIDER 独立，可单独切换）
# 端点：POST {base}/chat/completions（OpenAI 兼容 messages 数组）
# 支持 response_format json_schema（与 deepseek 路径同款 strict 结构化输出）
# 鉴权复用 AGENT_PLAN_API_KEY（与图片/视频同专属 key，不通用）
AGENT_PLAN_TEXT_MODEL=deepseek-v4-flash
AGENT_PLAN_TEXT_RPM=10
AGENT_PLAN_TEXT_REASONING_EFFORT=none
# 单次输出 token 上限。**本行是唯一来源**（provider 内无兜底常量）。0/空=不传该字段
#   → 服务端默认 4096 → 必然截断（截断会硬失败并打印 cap，配错立刻可见）。
# v6.59（09-04 实测）：65536 撞 3-5 分钟长尾（70k input 下生成时间随容量线性暴涨）→ 降 16384。
# v6.62.5（09-08 实测）：16384 太低——全脚本 JSON 实测 ≈66k 字符 ≈26k tokens，
#   4 个输出全脚本的站点必然 finish_reason=length，而旧 provider 把截断当 success
#   静默下发 → 表现为「多次 JSON 解析失败」（20 次调用 3 次截断，与 3 次解析失败 1:1）。
#   抬到 32768 = 实测 26k + 25% 余量。长尾若复现，改为给小提取调用显式传小
#   max_tokens（req.max_tokens 优先级更高），不要压低本行（会重现截断）。
AGENT_PLAN_TEXT_MAX_TOKENS=32768
AGENT_PLAN_TEXT_TIMEOUT_SEC=600  # 客户端读超时（秒）。doubao 长任务实测可超 300s，旧默认会让 GAP 重试必超时（2026-09-11 复盘）
# v6.66: 跨模型候选池——逗号分隔模型 ID，候选按序号轮转分配；空=全用上面 MODEL（零行为变化）
# 示例: deepseek-v4-flash,doubao-seed-2-1-turbo（候选取两者最优）
SCRIPT_CANDIDATE_MODELS=deepseek-v4-flash,doubao-seed-2-1-turbo

