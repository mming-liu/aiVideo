# baselines/ 里的证据文件保留原始字节（多数为 CRLF），manifest.json 的 sha256
# 按原始字节记录；core.autocrlf=true 会在 add/checkout 时改写它们，导致摘要失配。
# -text 禁止任何 eol 转换，保证干净 checkout 后 compare.py --verify 成立。
baselines/** -text

# 三族受控夹具由会话生成为 LF，manifest.json 的 sha256 按 LF 字节记录。
# 强制 LF 可避免 autocrlf=true 在 checkout 时写成 CRLF 使字节校验失败。
tests/shared/fixtures/execution_contract/** text eol=lf
