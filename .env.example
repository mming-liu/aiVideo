# ============================================================
# API 密钥
# ============================================================
DASHSCOPE_API_KEY=your_api_key_here

# ============================================================
# 文本生成（01_script_gen.py）
# ============================================================
# Provider 切换: "dashscope" (阿里百炼 Qwen) 或 "deepseek"
SCRIPT_PROVIDER=dashscope
# DashScope (百炼) 模型
DASHSCOPE_TEXT_MODEL=qwen-plus
# DeepSeek 配置（仅 SCRIPT_PROVIDER=deepseek 时需要）
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 视频生成（02_video_gen.py）
# ============================================================
VIDEO_PROVIDER=dashscope
VIDEO_OUTPUT_DIR=./output/clips
VIDEO_SIZE=832*1088
VIDEO_DURATION=6
DASHSCOPE_VIDEO_MODEL=wan2.7-t2v
DASHSCOPE_VIDEO_FALLBACK_MODELS=wan2.7-t2v-2026-04-25,happyhorse-1.1-t2v,happyhorse-1.0-t2v
DASHSCOPE_VIDEO_DURATION=0
DASHSCOPE_POLL_INTERVAL=8
DASHSCOPE_MAX_POLL_ATTEMPTS=120

# ============================================================
# 语音合成（03_tts_audio.py）
# ============================================================
TTS_PROVIDER=dashscope_sdk
DASHSCOPE_TTS_MODEL=sambert-zhide-v1
DASHSCOPE_TTS_FALLBACK_MODELS=sambert-zhida-v1,sambert-zhihao-v1,sambert-zhimo-v1,sambert-zhiyuan-v1
DASHSCOPE_TTS_RATE=1.5
DASHSCOPE_TTS_VOLUME=50
DASHSCOPE_TTS_FORMAT=mp3
DASHSCOPE_TTS_SAMPLE_RATE=16000
TTS_OUTPUT_PATH=./output/audio/narration.mp3

# ============================================================
# 成片合成（04_merge_ffmpeg.py）
# ============================================================
FFMPEG_BIN_DIR=
FFMPEG_AUDIO_VOLUME=5dB
FFMPEG_MAX_STRETCH=2.5
FFMPEG_CONTRAST=1.15
FFMPEG_SATURATION=0.85
FFMPEG_VIGNETTE_ANGLE=0.5236
MERGE_OUTPUT_PATH=./output/final.mp4
SUBTITLE_FONT=Sans
SUBTITLE_FONT_SIZE=20
SUBTITLE_COLOR=&H00FFFFFF
SUBTITLE_OUTLINE_COLOR=&H00000000
SUBTITLE_OUTLINE_WIDTH=1

# ============================================================
# 章节选择
# ============================================================
NOVEL_CHAPTER=1
PROMPT_MAX_CHARS=2000
